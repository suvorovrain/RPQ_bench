{
  "version": 1,
  "defaults": {
    "dataset": "wikidata",
    "runs": 5,
    "warmup_runs": 1
  },
  "semantics": {
    "wikidata": ["0"]
  },
  "variables": {
    "base_iri": "http://example.org/",
    "pathrex_binary": "{root}/Databases/pathrex/target/release/pathrex",
    "rpqmatrix_binary": "{root}/Databases/rpq-matrix/build/baseline_query",
    "rpqmatrix_gb_binary": "{root}/Databases/rpq-matrix_GB/build/baselineGB_query"
  },
  "datasets": {
    "wikidata": {
      "description": "Wikidata in /home/lamba/ADBIS2026",
      "n_triples": 609358925,
      "n_predicates": 1393,
      "query_sets": ["sparql-queries-any-con", "sparql-queries_CON_ANY", "only-any-safe"],
      "competitors": ["none", "join", "metaac", "mnc", "hybrid", "pang-hybrid", "sampling", "rpqmatrix", "rpqmatrix-gb"],
      "variables": {
        "query_catalog": "{root}/../wikidata-{query_set}.txt",
        "pathrex_query": "{query_catalog}",
        "pathrex_graph": "{root}/../wikidata/Wikidata/wikidata-mm",
        "rpqmatrix_dataset": "{root}/../wikidata/Wikidata/wikidata-orig/wikidata.dat",
        "rpqmatrix_gb_dataset": "{root}/../wikidata/Wikidata/wikidata-mm-txt/wikidata.dat",
        "rpqmatrix_query_catalog": "{root}/Queries/rpqmatrix/wikidata/wikidata-{query_set}.tsv",
        "results_root": "{root}/Results/wikidata",
        "analysis_output": "{root}/Scripts/benchmarks/benchmark_results/wikidata"
      }
    }
  },
  "competitors": {
    "none": {
      "label": "none",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/none/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench --bin pathrex",
        "command": ["{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm", "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix", "--rpqmatrix-optimizer", "none", "--output", "{output_path}", "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/none/res.json",
        "algorithm": "rpqmatrix",
        "table_metric": "total",
        "metrics": {"total": {"label": "none", "field": "total", "color": "#7f7f7f", "histogram": true}}
      }
    },
    "join": {
      "label": "join",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/join/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench --bin pathrex",
        "command": ["{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm", "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix", "--rpqmatrix-optimizer", "join", "--output", "{output_path}", "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/join/res.json",
        "algorithm": "rpqmatrix",
        "table_metric": "total",
        "metrics": {"total": {"label": "join", "field": "total", "color": "#1f77b4", "histogram": true}}
      }
    },
    "metaac": {
      "label": "metaac",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/metaac/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench --bin pathrex",
        "command": ["{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm", "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix", "--rpqmatrix-optimizer", "metaac", "--output", "{output_path}", "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/metaac/res.json",
        "algorithm": "rpqmatrix",
        "table_metric": "total",
        "metrics": {"total": {"label": "metaac", "field": "total", "color": "#ff7f0e", "histogram": true}}
      }
    },
    "mnc": {
      "label": "mnc",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/mnc/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench --bin pathrex",
        "command": ["{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm", "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix", "--rpqmatrix-optimizer", "mnc", "--output", "{output_path}", "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/mnc/res.json",
        "algorithm": "rpqmatrix",
        "table_metric": "total",
        "metrics": {"total": {"label": "mnc", "field": "total", "color": "#e377c2", "histogram": true}}
      }
    },
    "hybrid": {
      "label": "hybrid",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/hybrid/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench --bin pathrex",
        "command": ["{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm", "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix", "--rpqmatrix-optimizer", "hybrid", "--output", "{output_path}", "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/hybrid/res.json",
        "algorithm": "rpqmatrix",
        "table_metric": "total",
        "metrics": {"total": {"label": "hybrid", "field": "total", "color": "#2ca02c", "histogram": true}}
      }
    },
    "pang-hybrid": {
      "label": "pang-hybrid",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/pang-hybrid/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench,pathrex-sys/regenerate-bindings --bin pathrex",
        "command": ["{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm", "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix", "--rpqmatrix-optimizer", "pang-hybrid", "--output", "{output_path}", "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/pang-hybrid/res.json",
        "algorithm": "rpqmatrix",
        "verify_query_id": true,
        "table_metric": "total",
        "metrics": {
          "total": {"label": "pang-hybrid total", "field": "total", "color": "#17becf", "histogram": true},
          "ffi": {"label": "pang-hybrid ffi", "field": "ffi_only", "color": "#9edae5", "histogram": true}
        }
      }
    },
    "sampling": {
      "label": "sampling",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/sampling/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench,pathrex-sys/regenerate-bindings --bin pathrex",
        "command": ["{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm", "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix", "--rpqmatrix-optimizer", "sampling", "--output", "{output_path}", "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/sampling/res.json",
        "algorithm": "rpqmatrix",
        "verify_query_id": true,
        "table_metric": "total",
        "metrics": {
          "total": {"label": "sampling total", "field": "total", "color": "#8c564b", "histogram": true},
          "ffi": {"label": "sampling ffi", "field": "ffi_only", "color": "#c49c94", "histogram": true}
        }
      }
    },
    "rpqmatrix": {
      "label": "rpqmatrix",
      "run": {
        "binary": "{rpqmatrix_binary}",
        "query_path": "{rpqmatrix_query_catalog}",
        "validate_query_ids_against_catalog": true,
        "write_run_metadata": true,
        "output_path": "{results_root}/{query_set}/rpqmatrix/res.txt",
        "required_paths": ["{rpqmatrix_dataset}.SO", "{rpqmatrix_dataset}.P", "{rpqmatrix_dataset}.baseline-64/0001.mat"],
        "build_hint": "Build rpq-matrix: cmake --build {root}/Databases/rpq-matrix/build --target baseline_query -j 8",
        "command": ["{binary}", "{rpqmatrix_dataset}", "{query_path}", "{n_predicates}", "{n_triples}", "{runs}", "{warmup_runs}"],
        "stdout_include_regex": "^[0-9]+;"
      },
      "analysis": {
        "reader": "semicolon_batch",
        "path": "{results_root}/{query_set}/rpqmatrix/res.txt",
        "delimiter": ";",
        "value_column": 2,
        "verify_query_id": true,
        "warmup_runs": "{warmup_runs}",
        "runs": "{runs}",
        "table_metric": "total",
        "metrics": {"total": {"label": "rpqmatrix", "color": "#74c476", "histogram": true}}
      }
    },
    "rpqmatrix-gb": {
      "label": "rpqmatrix-gb",
      "run": {
        "binary": "{rpqmatrix_gb_binary}",
        "query_path": "{rpqmatrix_query_catalog}",
        "validate_query_ids_against_catalog": true,
        "write_run_metadata": true,
        "output_path": "{results_root}/{query_set}/rpqmatrix-gb/res.txt",
        "required_paths": ["{rpqmatrix_gb_dataset}.SO", "{rpqmatrix_gb_dataset}.P", "{rpqmatrix_gb_dataset}.baseline-64/0001.mat"],
        "build_hint": "Build rpq-matrix_GB: cmake --build {root}/Databases/rpq-matrix_GB/build --target baselineGB_query -j 8",
        "command": ["{binary}", "{rpqmatrix_gb_dataset}", "{query_path}", "{n_predicates}", "{n_triples}", "{runs}", "{warmup_runs}"],
        "stdout_include_regex": "^[0-9]+;"
      },
      "analysis": {
        "reader": "semicolon_batch",
        "path": "{results_root}/{query_set}/rpqmatrix-gb/res.txt",
        "delimiter": ";",
        "value_column": 2,
        "verify_query_id": true,
        "warmup_runs": "{warmup_runs}",
        "runs": "{runs}",
        "table_metric": "total",
        "metrics": {"total": {"label": "rpqmatrix-gb", "color": "#815394", "histogram": true}}
      }
    }
  }
}

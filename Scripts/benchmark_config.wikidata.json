{
  "version": 1,
  "defaults": {
    "dataset": "wikidata",
    "runs": 4,
    "warmup_runs": 2
  },
  "semantics": {
    "wikidata": ["0"]
  },
  "variables": {
    "base_iri": "http://example.org/",
    "pathrex_binary": "{root}/Databases/pathrex/target/release/pathrex"
  },
  "datasets": {
    "wikidata": {
      "description": "Wikidata: 609358925 triples, 91601734 vertices, 1393 predicates",
      "n_triples": 609358925,
      "n_vertices": 91601734,
      "n_predicates": 1393,
      "query_sets": [
        "only-any",
        "sparql-queries-any-con",
        "sparql-queries_CON_ANY"
      ],
      "competitors": [
        "none",
        "join",
        "metaac",
        "mnc",
        "hybrid"
      ],
      "variables": {
        "query_catalog": "/mnt/jblab2-disk/Georgiy/la-rpq/Experiments/Datasets/Wikidata/wikidata-{query_set}.txt",
        "pathrex_query": "/mnt/jblab2-disk/Georgiy/la-rpq/Experiments/Datasets/Wikidata/wikidata-{query_set}.txt",
        "pathrex_graph": "/mnt/jblab2-disk/Georgiy/la-rpq/Experiments/Datasets/Wikidata/wikidata-mm",
        "results_root": "{root}/Results/wikidata",
        "analysis_output": "{root}/Scripts/benchmarks/benchmark_results/wikidata"
      }
    }
  },
  "competitors": {
    "none": {
      "label": "none",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/none/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex with: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench --bin pathrex",
        "command": [
          "{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm",
          "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix",
          "--rpqmatrix-optimizer", "none", "--output", "{output_path}",
          "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"
        ]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/none/res.json",
        "algorithm": "rpqmatrix",
        "table_metric": "total",
        "metrics": {
          "total": {"label": "none", "field": "total", "color": "#7f7f7f", "histogram": true}
        }
      }
    },
    "join": {
      "label": "join",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/join/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex with: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench --bin pathrex",
        "command": [
          "{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm",
          "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix",
          "--rpqmatrix-optimizer", "join", "--output", "{output_path}",
          "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"
        ]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/join/res.json",
        "algorithm": "rpqmatrix",
        "table_metric": "total",
        "metrics": {
          "total": {"label": "join", "field": "total", "color": "#1f77b4", "histogram": true}
        }
      }
    },
    "metaac": {
      "label": "metaac",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/metaac/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex with: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench --bin pathrex",
        "command": [
          "{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm",
          "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix",
          "--rpqmatrix-optimizer", "metaac", "--output", "{output_path}",
          "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"
        ]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/metaac/res.json",
        "algorithm": "rpqmatrix",
        "table_metric": "total",
        "metrics": {
          "total": {"label": "metaac", "field": "total", "color": "#ff7f0e", "histogram": true}
        }
      }
    },
    "mnc": {
      "label": "mnc",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/mnc/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex with: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench --bin pathrex",
        "command": [
          "{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm",
          "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix",
          "--rpqmatrix-optimizer", "mnc", "--output", "{output_path}",
          "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"
        ]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/mnc/res.json",
        "algorithm": "rpqmatrix",
        "table_metric": "total",
        "metrics": {
          "total": {"label": "mnc", "field": "total", "color": "#e377c2", "histogram": true}
        }
      }
    },
    "hybrid": {
      "label": "hybrid",
      "run": {
        "binary": "{pathrex_binary}",
        "query_path": "{pathrex_query}",
        "output_path": "{results_root}/{query_set}/hybrid/res.json",
        "required_paths": ["{pathrex_graph}"],
        "build_hint": "Build Pathrex with: cargo build --release --manifest-path {root}/Databases/pathrex/Cargo.toml -p pathrex --features bench --bin pathrex",
        "command": [
          "{binary}", "bench", "--graph", "{pathrex_graph}", "--format", "mm",
          "--queries", "{query_path}", "--base-iri={base_iri}", "--algo", "rpqmatrix",
          "--rpqmatrix-optimizer", "hybrid", "--output", "{output_path}",
          "--runs", "{runs}", "--warm-up-runs", "{warmup_runs}"
        ]
      },
      "analysis": {
        "reader": "json_timing",
        "path": "{results_root}/{query_set}/hybrid/res.json",
        "algorithm": "rpqmatrix",
        "table_metric": "total",
        "metrics": {
          "total": {"label": "hybrid", "field": "total", "color": "#2ca02c", "histogram": true}
        }
      }
    }
  }
}
